# Copy this file to environments/local.env and adapt ISAAC_SIM_PATH.
# This file contains paths and environment names only. Never put tokens here.

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

export ISAAC_SIM_PATH=/absolute/path/to/isaac-sim-5.1.0
export SAM3_CHECKPOINT_DIR="${REPO_ROOT}/checkpoints/sam3"
export SAM3D_CHECKPOINT_DIR="${REPO_ROOT}/third_party/sam-3d-objects/checkpoints/hf"
export PIPELINE_OUTPUT_DIR="${REPO_ROOT}/outputs"
export SAM3_ENV=sam3
export SAM3D_ENV=sam3d-objects
