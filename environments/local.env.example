# Copy this file to environments/local.env and adapt paths for your workstation.
# This file contains paths only. Never put tokens or credentials here.

export ISAAC_SIM_PATH=/absolute/path/to/isaac-sim-5.1.0
export SAM3_CHECKPOINT_DIR=/absolute/path/to/checkpoints/sam3
export SAM3D_CHECKPOINT_DIR=/absolute/path/to/third_party/sam-3d-objects/checkpoints/hf
export PIPELINE_OUTPUT_DIR=/absolute/path/to/outputs
